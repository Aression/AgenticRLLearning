{
  "description": "Agentic RL Atlas maintenance policy",
  "refresh": {
    "sourceAudit": "research/source-audit.json",
    "discovery": "research/discovery.json",
    "networkWrites": "explicit-only",
    "maxDiscoveryResults": 25
  },
  "cardGeneration": {
    "maxCards": 3,
    "decisions": ["review"],
    "requireFullText": true,
    "reviewStatus": "LLM 全文精读草稿 · 待人工复核",
    "maxFullTextChars": 60000
  },
  "checks": {
    "requireSourceForPublishedNote": true,
    "requireIsoUpdated": true,
    "validateInternalNoteLinks": true,
    "validateSourceIds": true,
    "failOnBrokenExternalLinks": false
  },
  "reviewPolicy": {
    "preprintStatuses": ["摘要核验 · 待精读"],
    "neverAutoPublish": true,
    "humanReviewRequiredFor": ["new-source", "new-claim", "source-replacement", "frontier-status-change", "llm-generated-card"]
  }
}
